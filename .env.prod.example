APP_DOMAIN=fridge.example.com
ACME_EMAIL=ops@example.com
# 正式域名使用 ACME 联系邮箱；本机冒烟可改为 internal。
CADDY_TLS_MODE=ops@example.com
ADMIN_BOOTSTRAP_EMAIL=administrator@example.com
APP_TIMEZONE=Asia/Shanghai
API_IMAGE=ghcr.io/your-org/xianzhi-api:sha-REPLACE
WEB_IMAGE=ghcr.io/your-org/xianzhi-web:sha-REPLACE
BACKUP_IMAGE=ghcr.io/your-org/xianzhi-backup:sha-REPLACE
MQTT_ENABLED=true
MQTT_SERVICE_USERNAME=service
EMQX_DASHBOARD_USERNAME=admin
SPEECH_PROVIDER=openai
SPEECH_BASE_URL=https://api.openai.com/v1
SPEECH_MODEL=whisper-1
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=xianzhi-speech
STORAGE_PATH_STYLE=true
AI_EXTERNAL_CALLS_ENABLED=true
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL_NAME=deepseek-chat
AI_VECTOR_ENABLED=true
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RESTIC_REPOSITORY=

#!/usr/bin/env bash
set -e
MVN_VERSION=3.9.9
BASE_DIR="$(cd "$(dirname "$0")" && pwd)"
MVN_DIR="$BASE_DIR/.mvn/apache-maven-$MVN_VERSION"
if [ ! -x "$MVN_DIR/bin/mvn" ]; then
  echo "[mvnw] Downloading Apache Maven $MVN_VERSION ..."
  mkdir -p "$BASE_DIR/.mvn"
  TMP_ZIP="${TMPDIR:-/tmp}/apache-maven-$MVN_VERSION-bin.zip"
  curl -fsSL "https://archive.apache.org/dist/maven/maven-3/$MVN_VERSION/binaries/apache-maven-$MVN_VERSION-bin.zip" -o "$TMP_ZIP"
  unzip -q "$TMP_ZIP" -d "$BASE_DIR/.mvn"
fi
exec "$MVN_DIR/bin/mvn" "$@"

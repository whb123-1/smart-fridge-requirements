MYSQL_DATABASE=xianzhi
MYSQL_USER=xianzhi
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_HOST=mysql
MYSQL_PORT=3306
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/xianzhi?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC
REDIS_URL=redis://redis:6379/0
JWT_ISSUER=xianzhi-api
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P30D
JWT_SIGNING_KEY=replace-with-a-32-byte-minimum-development-secret
REFRESH_COOKIE_SECURE=false
APP_TIMEZONE=Asia/Shanghai
MQTT_ENABLED=true
MQTT_BROKER_URL=tcp://emqx:1883
MQTT_PUBLIC_BROKER_URL=tcp://localhost:1883
MQTT_SERVICE_USERNAME=service
MQTT_SERVICE_PASSWORD=change-me-service
MQTT_SIMULATOR_USERNAME=simulator
MQTT_SIMULATOR_PASSWORD=change-me-simulator
MQTT_INTERNAL_TOKEN=replace-with-an-internal-development-token
MQTT_SIMULATOR_EMIT_INTERVAL=PT1M
EMQX_DASHBOARD_USERNAME=admin
EMQX_DASHBOARD_PASSWORD=change-me-emqx
EMQX_NODE_COOKIE=replace-with-a-development-erlang-cookie
DEBUG_TEST_OPERATOR_USERNAMES=demo
ADMIN_USERNAMES=demo
SPEECH_FAKE_ENABLED=true
SPEECH_FAKE_TRANSCRIPT=鸡蛋 2 个
SPEECH_STORAGE_PATH=/data/speech
SPEECH_MAX_UPLOAD_BYTES=10485760
AI_EXTERNAL_CALLS_ENABLED=false
AI_MODEL_NAME=rules-v1
AI_VECTOR_ENABLED=false
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=xianzhi_recipes
MINIO_ROOT_USER=xianzhi
MINIO_ROOT_PASSWORD=change-me-minio
